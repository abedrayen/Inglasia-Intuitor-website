# Calendly booking (server-side only — read by netlify/functions, never by the browser).
# Copy to .env for `netlify dev`; set the real values in Netlify → Site configuration → Environment variables.
CALENDLY_PERSONAL_ACCESS_TOKEN=replace_with_real_token
# Canonical API URI (https://api.calendly.com/event_types/<uuid>), NOT the public calendly.com/d/... link.
# Find it with: node netlify/scripts/resolve-event-type.mjs
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/replace_with_event_type_uuid
